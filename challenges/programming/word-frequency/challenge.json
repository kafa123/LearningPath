  "constraints": [
    "Words are separated by whitespace.",
    "Treat words case-insensitively and compare them in lowercase.",
    "Ignore punctuation attached to a word's edges.",
    "Break count ties alphabetically.",
    "Return at most count words."
  ],
  "examples": [
    {
      "input": "text = \"the cat and the dog\", count = 2",
      "output": "[\"the\", \"and\"]",
      "explanation": "the appears twice; and and cat and dog each appear once, so the alphabetical tie-break selects and."
    },
    {
      "input": "text = \"One one TWO\", count = 3",
      "output": "[\"one\", \"two\"]",
      "explanation": "Only two distinct words remain after normalization; the result may contain fewer than count entries."
    }
  ],
