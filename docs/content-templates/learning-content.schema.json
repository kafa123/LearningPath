{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psel.local/content-templates/learning-content.schema.json",
  "title": "PSEL learning content pack",
  "description": "Draft format for a learning content import. The API does not read this file yet.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "domains"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/domain"
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "name",
        "description",
        "sortOrder",
        "modules"
      ],
      "properties": {
        "slug": {
          "$ref": "#/$defs/slug",
          "maxLength": 100
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "sortOrder": {
          "type": "integer",
          "minimum": 1
        },
        "modules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/module"
          }
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "title",
        "summary",
        "level",
        "estimatedMinutes",
        "sortOrder",
        "objectives",
        "competencies",
        "materials",
        "prerequisites"
      ],
      "properties": {
        "slug": {
          "$ref": "#/$defs/slug",
          "maxLength": 120
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "level": {
          "enum": [
            "Beginner",
            "Intermediate",
            "Advanced"
          ]
        },
        "estimatedMinutes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 600
        },
        "sortOrder": {
          "type": "integer",
          "minimum": 1
        },
        "objectives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/objective"
          }
        },
        "competencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/competency"
          }
        },
        "materials": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/material"
          }
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slug",
            "maxLength": 120
          },
          "uniqueItems": true,
          "description": "Slug module lain yang harus sudah dikenal. Boleh kosong."
        }
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sortOrder",
        "text"
      ],
      "properties": {
        "sortOrder": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        }
      }
    },
    "competency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "name",
        "description",
        "sortOrder"
      ],
      "properties": {
        "slug": {
          "$ref": "#/$defs/slug",
          "maxLength": 140
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "sortOrder": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "title",
        "kind",
        "estimatedMinutes",
        "sortOrder",
        "bodyMarkdown"
      ],
      "properties": {
        "slug": {
          "$ref": "#/$defs/slug",
          "maxLength": 140
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "estimatedMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "sortOrder": {
          "type": "integer",
          "minimum": 1
        },
        "bodyMarkdown": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
