{
  "Database": {
    "Path": "data/psel.db"
  },
  "Challenges": {
    "Path": "../../challenges"
  },
  "Execution": {
    "Enabled": true,
    "DockerExecutable": "docker",
    "CSharpImage": "mcr.microsoft.com/dotnet/sdk:10.0",
    "PythonImage": "python:3.13-slim",
    "SqlImage": "python:3.13-slim",
    "TimeLimitSeconds": 60,
    "MemoryLimitMb": 512,
    "CpuLimit": 1.0,
    "PidsLimit": 128,
    "MaxOutputBytes": 65536,
    "MaxConcurrentExecutions": 2,
    "MaxQueuedExecutions": 64,
    "ContainerUser": "1000:1000"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]"
}
